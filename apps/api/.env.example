# Copy to apps/api/.env for local development. Never commit the real .env.
# Values below match docker-compose.yml.

NODE_ENV=development
PORT=4000
# Used to build links in emails (invites, password resets).
WEB_APP_URL=http://localhost:5173
# Number of reverse proxies in front of the API (0 locally, usually 1 in production),
# so rate limits see the real client IP.
TRUST_PROXY=0

DATABASE_URL=postgresql://brillanda:brillanda@localhost:5432/brillanda?schema=public
TEST_DATABASE_URL=postgresql://brillanda:brillanda@localhost:5432/brillanda_test?schema=public
REDIS_URL=redis://localhost:6379

# Use long random strings in production (e.g. `openssl rand -base64 48`).
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
# A session unused for this long must log in again (FR-22.4).
SESSION_IDLE_TIMEOUT_HOURS=24
# Even an active session must log in again after this long.
SESSION_MAX_DAYS=30

# Mailpit in development; a real SMTP provider in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Brillanda <no-reply@brillanda.local>"

# local = files under STORAGE_LOCAL_DIR; s3 = any S3-compatible bucket (R2, AWS S3).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
